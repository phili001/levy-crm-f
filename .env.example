# Variables del despliegue. Es lo que EasyPanel importa al crear el servicio
# desde docker-compose.easypanel.yml: rellena estos huecos y ya está.
#
# Solo hay 11 (más TRUSTED_PROXY_COUNT, que va comentada abajo y se explica
# allí). El resto (base de datos, Redis, colas, puertos, rutas, copias,
# retenciones) las arma el propio compose, y las claves de proveedores —OpenAI,
# WhatsApp, Instagram, Resend…— se ponen luego desde el panel, cifradas.
#
# Para trabajar en local: .env.desarrollo.example
# Lista completa de opcionales con su valor por defecto: anexo de docs/avanzado/easypanel.md

# === Aplicación ===
# En los dominios: con https, SIN barra final.
APP_NAME=CRM Omnicanal
APP_BASE_URL=https://api.TU-DOMINIO
FRONTEND_BASE_URL=https://TU-DOMINIO

# === Base de datos ===
# POSTGRES_PASSWORD con: openssl rand -hex 24   (hex, nunca base64)
POSTGRES_USER=chatbot
POSTGRES_DB=chatbot
POSTGRES_PASSWORD=

# === Seguridad ===
# JWT_SECRET con:     openssl rand -base64 48
# ENCRYPTION_KEY con: openssl rand -base64 32 | tr '+/' '-_'
JWT_SECRET=
ENCRYPTION_KEY=

# === Admin inicial ===
# La contraseña: mínimo 12 caracteres, con letras y números, y que no sea de las
# de siempre ni contenga tu correo. Si no cumple, el primer arranque aborta.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Perfil del primer arranque: dental-mx o blank (opcional; por defecto dental-mx).
SEED_PROFILE=dental-mx

# === Ajustes ===
# TRUSTED_PROXY_COUNT = cuántos proxies hay por delante del backend. Sirve para
# saber cuál es la IP real de quien llama, que es por la que se cuentan los
# intentos de login.
#
# VA COMENTADA A PROPÓSITO, no es un olvido. El backend ya arranca con 1
# (backend/app/core/config.py), que es lo normal en EasyPanel: dejarla así NO
# cambia el comportamiento. Lo que consigue es que en el primer arranque salte
# un aviso en los logs recordándote comprobarlo — el aviso solo se dispara si
# NADIE ha definido la variable. En cuanto la defines aquí, no vuelve a salir.
#
# ⚠️ Descoméntala y pon el número REAL si delante hay más de un proxy (por
# ejemplo Cloudflare + EasyPanel = 2). Si el número se queda corto, el límite
# de intentos de login deja de contar por persona y cuenta 5 en total para todo
# el mundo junto: a partir del sexto fallo NADIE puede entrar al panel. Cómo
# contarlos en tu instalación: docs/avanzado/easypanel.md § 10.
# TRUSTED_PROXY_COUNT=1
DEFAULT_LLM_MODEL=gpt-5.4-mini
